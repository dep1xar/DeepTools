# Build output
bin/
obj/
*.user
.vs/

# Собранные исполняемые файлы (кладутся в GitHub Releases, а не в репозиторий)
DeepTools.exe
DeepTools_build.exe
DeepTools_old.exe
DeepToolsStats.exe
DeepToolsStats_build.exe
DeepToolsStats_old.exe

# Вшитые при сборке адрес сервера и ключ просмотра
BuildSecrets.g.cs
src/BuildSecrets.g.cs

# Логи сборки
build.log
build.log.err

# Установщики сторонних компонентов
PawnIO_setup.exe

# Личные скриншоты
screenshots/

# Локальный конфиг
config.txt

# Локальный стенд для рендер-тестов интерфейса (не часть сборки)
.visualtest/

# Служебные файлы Windows
desktop.ini

# Резервные копии, которые DeepTools делает перед правкой настроек браузеров
*.deeptools.bak
*.deeptools.bak-wal
*.deeptools.bak-shm
*.deeptools.tmp

# Локальные данные сервера телеметрии
server/data/
server/*.db
server/*.db-shm
server/*.db-wal
server/__pycache__/
*.pyc

# Локальное состояние Cloudflare Worker/Pages и токен просмотра
server/worker/.wrangler/
server/worker/.dev.vars
server/worker/.stats-token
server/worker/node_modules/
server/pages/.wrangler/
