@echo off
chcp 65001 >nul
REM ====================================================================
REM  Двойной клик по этому файлу собирает DeepTools.exe из исходников.
REM  Окно НЕ закроется само - в конце будет пауза, чтобы увидеть
REM  результат сборки или текст ошибки.
REM
REM  Важно: рядом с этим файлом должны лежать ВСЕ файлы репозитория -
REM  все *.cs и все *.dll. Скачивай целиком (Code -> Download ZIP) и
REM  распаковывай, не по одному файлу.
REM ====================================================================
echo Сборка DeepTools... (не закрывай это окно)
echo.
powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0build.ps1"
echo.
echo ====================================================================
echo  Готово. Прочитай сообщение выше. Если есть "Ошибка компиляции" -
echo  скопируй текст и пришли разработчику.
echo ====================================================================
pause
